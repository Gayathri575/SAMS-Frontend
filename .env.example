# SAMS API Configuration
# By default, client.js uses:
# - http://localhost:8081/api on Web and iOS simulator
# - http://10.0.2.2:8081/api on Android emulator
#
# If your backend endpoints do not use the '/api' prefix, set:
# EXPO_PUBLIC_API_URL=http://localhost:8081
#
# If testing on a physical phone via Expo Go, set your computer's LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.x.x:8081/api
EXPO_PUBLIC_API_URL=http://localhost:8081/api

